# Copy to .env and replace every change-me value for a real deployment.
POSTGRES_PASSWORD=change-me-db
JWT_SECRET=change-me-jwt-secret-use-a-long-random-value
ADMIN_PASSWORD=admin
OPERATOR_PASSWORD=operator
VIEWER_PASSWORD=viewer
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
DEMO_MODE=true

# Alertmanager SMTP (optional)
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=monitor@example.com
SMTP_AUTH_USERNAME=monitor@example.com
SMTP_AUTH_PASSWORD=change-me-smtp
ALERT_EMAIL_TO=ops@example.com
