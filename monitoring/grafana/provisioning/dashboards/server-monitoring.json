{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Servers UP",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(up{job=\"linux-servers\"} == 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Servers DOWN",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(up{job=\"linux-servers\"} == 0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{job=\"linux-servers\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"linux-servers\"} / node_memory_MemTotal_bytes{job=\"linux-servers\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Usage %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"linux-servers\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"linux-servers\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Receive Bytes/s",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by(instance) (rate(node_network_receive_bytes_total{job=\"linux-servers\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 41,
  "style": "dark",
  "tags": [
    "data-center",
    "linux",
    "prometheus"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Data Center Server Monitoring",
  "uid": "dc-server-monitoring"
}